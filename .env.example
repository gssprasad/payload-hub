# Copy to .env and fill in. Keep .env out of git (it is ignored).
POSTGRES_PASSWORD=change-me
ADMIN_PASSWORD=change-me-too
# The master key for stored credentials. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# and keep a copy somewhere safe - without it stored credentials can't be decrypted (backups need it too).
PAYLOAD_HUB_SECRET_KEY=
PAYLOAD_HUB_ENVIRONMENT=DEV

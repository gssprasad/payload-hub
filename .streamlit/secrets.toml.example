# Copy to .streamlit/secrets.toml to test locally, or paste into
# Streamlit Community Cloud: app > Settings > Secrets.
# Never commit the real secrets.toml.

# Run the backend + Kafka pipeline inside the Streamlit process (required on Streamlit Cloud)
EMBED_BACKEND = "true"

# Initial password for the built-in "Administrator" account, used only when the database has no users yet.
# Add more users (read / write / delete) on the Users page after signing in.
ADMIN_PASSWORD = "choose-a-strong-password"

# Hosted PostgreSQL (Neon): Dashboard > Connection string, keep sslmode=require
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Hosted Kafka (Aiven): service Overview > Connection information > SASL
KAFKA_BOOTSTRAP = "your-kafka-service.aivencloud.com:12345"
KAFKA_SECURITY_PROTOCOL = "SASL_SSL"
KAFKA_SASL_MECHANISM = "SCRAM-SHA-256"
KAFKA_USERNAME = "avnadmin"
KAFKA_PASSWORD = "your-kafka-password"
KAFKA_CA_CERT = """
-----BEGIN CERTIFICATE-----
paste the CA certificate (ca.pem) here
-----END CERTIFICATE-----
"""

# Optional: enables the AI mapping agent
ANTHROPIC_API_KEY = "your-anthropic-api-key"

# Encrypts AI provider keys pasted in the app (generate: python -c "from cryptography.fernet import Fernet;
# print(Fernet.generate_key().decode())"). Keep it unchanged, or keys pasted earlier must be pasted again.
PAYLOAD_HUB_SECRET_KEY = "generate-one"

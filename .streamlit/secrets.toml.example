# Copy to .streamlit/secrets.toml to test locally, or paste into
# Streamlit Community Cloud: app > Settings > Secrets.
# Never commit the real secrets.toml.

# Run the backend + Kafka pipeline inside the Streamlit process (required on Streamlit Cloud)
EMBED_BACKEND = "true"

# Password visitors must enter to open the app
APP_PASSWORD = "choose-a-demo-password"

# Hosted PostgreSQL (Neon): Dashboard > Connection string, keep sslmode=require
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Hosted Kafka (Aiven): service Overview > Connection information > SASL
KAFKA_BOOTSTRAP = "your-kafka-service.aivencloud.com:12345"
KAFKA_SECURITY_PROTOCOL = "SASL_SSL"
KAFKA_SASL_MECHANISM = "SCRAM-SHA-256"
KAFKA_USERNAME = "avnadmin"
KAFKA_PASSWORD = "your-kafka-password"
KAFKA_CA_CERT = """
-----BEGIN CERTIFICATE-----
paste the CA certificate (ca.pem) here
-----END CERTIFICATE-----
"""

# Optional: enables the AI mapping agent
ANTHROPIC_API_KEY = "your-anthropic-api-key"

# Server settings for one environment - copy to .env next to docker-compose.yml (keep it private, not in git).
PAYLOAD_HUB_ENVIRONMENT=TEST
DATABASE_URL=postgresql://payloadhub:<password>@<postgres host>:5432/payloadhub?sslmode=require
KAFKA_BOOTSTRAP=<broker1>:9092,<broker2>:9092,<broker3>:9092
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_USERNAME=...
# KAFKA_PASSWORD=...
KAFKA_TOPIC_PARTITIONS=6
# The master key of THIS environment - each environment has its own. Back it up safely.
PAYLOAD_HUB_SECRET_KEY=
ADMIN_PASSWORD=
PAYLOAD_HUB_APP_URL=https://payload-hub-test.company.local
# PAYLOAD_HUB_GRAFANA_URL=https://grafana.company.local/d/payload-hub
# PAYLOAD_HUB_SSO_SECRET=
TZ=UTC
